# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง (ห้าม commit ไฟล์ .env)
#   macOS:   cp .env.example .env
#   Windows: copy .env.example .env

# connection string แบบ Session pooler จากหน้า Connect ของ Supabase
# host ต้องลงท้ายด้วย pooler.supabase.com และ port เป็น 5432
# อย่าลืมเปลี่ยน [YOUR-DATABASE-PASSWORD] เป็นรหัสผ่านฐานข้อมูลที่จดไว้ตอนสร้างโปรเจกต์
DATABASE_URL=postgresql://postgres.<project-ref>:[YOUR-DATABASE-PASSWORD]@aws-0-<region>.pooler.supabase.com:5432/postgres

# port ของ backend
PORT=8080

# ที่อยู่ของ frontend (ใช้ตั้งค่า CORS)
FRONTEND_ORIGIN=http://localhost:3000
