meta {
  name: 13 · คำสั่งซื้อของฉัน
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/orders
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

assert {
  res.status: eq 200
  res.body.data: isArray
}

docs {
  ## GET /api/orders

  หน้าคำสั่งซื้อของฉัน · private

  ตอบเฉพาะคำสั่งซื้อของคนที่ login ใหม่สุดอยู่บน

  ```json
  { "data": [ { "id": 1, "status": "pending", "total_satang": 64000, "created_at": "...", "items": [ ... ] } ] }
  ```

  ตอนนี้ backend ยังไม่มีเส้นนี้ จึงได้ `404` และ assert ด้านบนไม่ผ่าน เป็นเรื่องปกติ เราจะเขียนให้ผ่านในโมดูล 5
}
