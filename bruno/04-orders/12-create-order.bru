meta {
  name: 12 · สั่งซื้อ
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/orders
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

assert {
  res.status: eq 201
  res.body.data.status: eq pending
}

script:post-response {
  // เก็บเลขคำสั่งซื้อไว้ให้ 14 และ 16 ใช้
  if (res.status === 201) {
    bru.setVar("orderId", res.body.data.id);
  }
}

docs {
  ## POST /api/orders

  ปุ่ม "สั่งซื้อ" ในหน้าตะกร้า · private · ไม่ต้องส่ง body

  backend เอาของในตะกร้ามาสร้างคำสั่งซื้อ ตัดสต็อก แล้วล้างตะกร้า
  ตอบ `201 Created` พร้อมคำสั่งซื้อที่สร้าง หน้าเว็บพาไปหน้า `/orders/:id`

  ```json
  { "data": {
    "id": 1,
    "status": "pending",
    "total_satang": 64000,
    "created_at": "2026-11-27T10:30:00Z",
    "items": [
      { "product_id": 1, "product_name": "กาแฟอาราบิก้าดอยช้าง 250 กรัม", "price_satang": 32000, "quantity": 2 }
    ]
  } }
  ```

  | กรณี | status | code |
  |---|---|---|
  | ตะกร้าว่าง | `400` | `cart_empty` |
  | สต็อกไม่พอแล้ว (มีคนซื้อตัดหน้า) | `409` | `out_of_stock` |

  ชื่อและราคาสินค้าถูกคัดลอกไว้ใน `items` ถ้าภายหลังร้านเปลี่ยนราคา คำสั่งซื้อเก่าจะไม่เปลี่ยนตาม

  ตอนนี้ backend ยังไม่มีเส้นนี้ จึงได้ `404` และ assert ด้านบนไม่ผ่าน เป็นเรื่องปกติ เราจะเขียนให้ผ่านในโมดูล 5
}
