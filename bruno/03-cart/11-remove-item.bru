meta {
  name: 11 · เอาสินค้าออก
  type: http
  seq: 4
}

delete {
  url: {{baseUrl}}/api/cart/items/:productId
  body: none
  auth: bearer
}

params:path {
  productId: 1
}

auth:bearer {
  token: {{token}}
}

assert {
  res.status: eq 204
}

docs {
  ## DELETE /api/cart/items/:productId

  ปุ่มลบในหน้าตะกร้า · private

  ตอบ `204 No Content` (สำเร็จ ไม่มี body) หน้าเว็บโหลดตะกร้าใหม่เอง

  - ไม่มีสินค้านี้ในตะกร้า → `404`

  ตอนนี้ backend ยังไม่มีเส้นนี้ จึงได้ `404` และ assert ด้านบนไม่ผ่าน เป็นเรื่องปกติ เราจะเขียนให้ผ่านในโมดูล 5
}
