meta {
  name: 09 · ใส่สินค้าลงตะกร้า
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/cart/items
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "product_id": 1,
    "quantity": 2
  }
}

assert {
  res.status: eq 201
}

docs {
  ## POST /api/cart/items

  ปุ่ม "ใส่ตะกร้า" ในหน้ารายละเอียดสินค้า · private

  ตอบ `201` พร้อมตะกร้าล่าสุด (รูปแบบเดียวกับ **08 · ดูตะกร้า**)
  ถ้ามีสินค้านี้ในตะกร้าแล้ว ให้บวกจำนวนเพิ่ม

  | กรณี | status | code |
  |---|---|---|
  | `quantity` น้อยกว่า 1 | `400` | `validation_error` |
  | ไม่มีสินค้า `product_id` นี้ | `404` | `not_found` |
  | สต็อกไม่พอ (ลอง `product_id` ของแก้วเซรามิก ที่สต็อก 0) | `409` | `out_of_stock` |

  ตอนนี้ backend ยังไม่มีเส้นนี้ จึงได้ `404` และ assert ด้านบนไม่ผ่าน เป็นเรื่องปกติ เราจะเขียนให้ผ่านในโมดูล 5
}
