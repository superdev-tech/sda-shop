meta {
  name: 02 · หมวดหมู่
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/categories
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.body.data: isArray
}

docs {
  ## GET /api/categories

  ใช้ 3 หน้า: หน้าแรก (เมนูหมวด) · รายการสินค้า (ตัวกรอง) · หลังร้าน (เลือกหมวดตอนเพิ่มสินค้า) · public

  ```json
  { "data": [
    { "id": 1, "slug": "coffee", "name": "กาแฟ" },
    { "id": 2, "slug": "tea", "name": "ชา" }
  ] }
  ```

  ตอนนี้ backend ยังไม่มีเส้นนี้ จึงได้ `404` และ assert ด้านบนไม่ผ่าน เป็นเรื่องปกติ เราจะเขียนให้ผ่านในโมดูล 5
}
