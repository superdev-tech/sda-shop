meta {
  name: 01 · สินค้าแนะนำ
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/products/featured
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.body.data: isArray
}

docs {
  ## GET /api/products/featured

  หน้าแรก ส่วน "สินค้าแนะนำ" · public

  ตอบ `200` เฉพาะสินค้าที่ `is_featured = true`

  ```json
  { "data": [ {
      "id": 1,
      "slug": "doi-chang-arabica",
      "name": "กาแฟอาราบิก้าดอยช้าง 250 กรัม",
      "description": "คั่วกลาง หอมถั่วและช็อกโกแลต",
      "price_satang": 32000,
      "stock": 40,
      "image_url": "/images/coffee.svg",
      "is_featured": true,
      "category": { "id": 1, "slug": "coffee", "name": "กาแฟ" }
    } ] }
  ```

  ตอนนี้ backend ยังไม่มีเส้นนี้ จึงได้ `404` และ assert ด้านบนไม่ผ่าน เป็นเรื่องปกติ เราจะเขียนให้ผ่านในโมดูล 5
}
