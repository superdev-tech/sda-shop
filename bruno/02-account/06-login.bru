meta {
  name: 06 · เข้าสู่ระบบ
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "{{customerEmail}}",
    "password": "{{customerPassword}}"
  }
}

assert {
  res.status: eq 200
  res.body.data.token: isString
}

script:post-response {
  // เก็บ token ไว้ให้ request ที่ต้อง login ใช้ต่อ
  if (res.status === 200) {
    bru.setVar("token", res.body.data.token);
  }
}

docs {
  ## POST /api/auth/login

  หน้าเข้าสู่ระบบ · public

  ```json
  { "data": {
    "token": "eyJhbGciOi...",
    "user": { "id": 2, "email": "somchai@example.com", "name": "สมชาย ใจดี", "role": "customer" }
  } }
  ```

  - อีเมลหรือรหัสผ่านผิด → `401` `invalid_credentials`
    ข้อความเดียวกันทั้งสองกรณี **ไม่บอกว่าผิดที่อีเมลหรือรหัส** เพื่อไม่ให้คนเดาได้ว่าอีเมลไหนมีบัญชี

  script ด้านล่างเก็บ `token` ไว้ในตัวแปร `{{token}}`

  ตอนนี้ backend ยังไม่มีเส้นนี้ จึงได้ `404` และ assert ด้านบนไม่ผ่าน เป็นเรื่องปกติ เราจะเขียนให้ผ่านในโมดูล 5
}
