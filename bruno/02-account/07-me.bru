meta {
  name: 07 · โปรไฟล์ของฉัน
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/me
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

assert {
  res.status: eq 200
  res.body.data.email: eq {{customerEmail}}
}

docs {
  ## GET /api/me

  หน้าโปรไฟล์ · **private** (ต้อง login)

  ใช้ `/me` แทน `/users/:id` เพราะ backend รู้อยู่แล้วว่าเป็นใครจาก token

  ```json
  { "data": { "id": 2, "email": "somchai@example.com", "name": "สมชาย ใจดี", "role": "customer" } }
  ```

  - ไม่มี token หรือ token หมดอายุ → `401` `unauthorized`

  ตอนนี้ backend ยังไม่มีเส้นนี้ จึงได้ `404` และ assert ด้านบนไม่ผ่าน เป็นเรื่องปกติ เราจะเขียนให้ผ่านในโมดูล 5
}
