meta {
  name: ตัวช่วย · เข้าสู่ระบบ admin
  type: http
  seq: 0
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "{{adminEmail}}",
    "password": "{{adminPassword}}"
  }
}

assert {
  res.status: eq 200
  res.body.data.user.role: eq admin
}

script:post-response {
  // เก็บ token ของ admin แยกจาก token ของลูกค้า
  if (res.status === 200) {
    bru.setVar("adminToken", res.body.data.token);
  }
}

docs {
  ## ตัวช่วย: POST /api/auth/login ด้วยบัญชี admin

  ไม่ใช่เส้นใหม่ เป็นเส้น **06 · เข้าสู่ระบบ** เส้นเดิม แค่ใช้บัญชี admin
  script จะเก็บ token ไว้ใน `{{adminToken}}` ให้เส้น 15–17

  ตอนนี้ backend ยังไม่มีเส้นนี้ จึงได้ `404` และ assert ด้านบนไม่ผ่าน เป็นเรื่องปกติ เราจะเขียนให้ผ่านในโมดูล 5
}
