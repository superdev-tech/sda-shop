meta {
  name: 16 · เปลี่ยนสถานะคำสั่งซื้อ
  type: http
  seq: 2
}

patch {
  url: {{baseUrl}}/api/admin/orders/:id/status
  body: json
  auth: bearer
}

params:path {
  id: {{orderId}}
}

auth:bearer {
  token: {{adminToken}}
}

body:json {
  {
    "status": "paid"
  }
}

assert {
  res.status: eq 200
  res.body.data.status: eq paid
}

docs {
  ## PATCH /api/admin/orders/:id/status

  ช่องเลือกสถานะในหน้าหลังร้าน · admin

  สถานะที่ใช้ได้: `pending` → `paid` → `shipped` → `completed` หรือ `cancelled`
  ตอบ `200` พร้อมคำสั่งซื้อที่อัปเดตแล้ว

  - สถานะไม่อยู่ในรายการ → `400` `validation_error`
  - ไม่มีคำสั่งซื้อนี้ → `404`

  ตอนนี้ backend ยังไม่มีเส้นนี้ จึงได้ `404` และ assert ด้านบนไม่ผ่าน เป็นเรื่องปกติ เราจะเขียนให้ผ่านในโมดูล 5
}
